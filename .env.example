GROK_API_KEY=your_grok_api_key
GROK_MODEL=qwen/qwen3-8b
GROK_BASE_URL=https://api.x.ai/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Alternative (Groq)
# GROK_API_KEY=gsk_...
# GROK_BASE_URL=https://api.groq.com/openai/v1
# GROK_MODEL=llama-3.1-8b-instant

HOSTEL_BACKEND_URL=http://localhost:8000
AGENT_API_PREFIX=/api/agent
REQUEST_TIMEOUT=30

ENV=development
# In production (ENV=production), DATABASE_URL must be explicitly set; dev fallback is isolated
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hostel_management
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg2://postgres:changeme@localhost:5434/hostel_management

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
